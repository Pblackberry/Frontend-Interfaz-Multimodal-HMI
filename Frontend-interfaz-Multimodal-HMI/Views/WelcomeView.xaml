<UserControl x:Class="Frontend_interfaz_Multimodal_HMI.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Decoración (reemplaza los PNG de Assets por los exportados de Figma) -->
    <Image Source="/Assets/ice_top_left.png" Width="170"
               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
    <Image Source="/Assets/ice_bottom_right.png" Width="170"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>

    <Border Style="{StaticResource PanelCard}" Width="310"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="¡Hola! Me llamo Rony" Style="{StaticResource Title}"/>
        <TextBlock Text="Pídeme una bebida:" Style="{StaticResource Subtitle}" Margin="0,10,0,0"/>

        <TextBlock Text="“Rony, quiero tomar algo”" Style="{StaticResource Hint}" Margin="0,28,0,0"/>

        <Button Style="{StaticResource MicButton}" Margin="0,22,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding StartListeningCommand}"/>

        <TextBlock Text="O haz click en pedir bebida" Style="{StaticResource Subtitle}" Margin="0,22,0,0"/>

        <Button Content="Pedir bebida" Style="{StaticResource PrimaryButton}"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Command="{Binding StartOrderCommand}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
