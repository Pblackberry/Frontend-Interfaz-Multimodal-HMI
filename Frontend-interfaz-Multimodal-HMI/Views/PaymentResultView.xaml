<UserControl x:Class="Frontend_interfaz_Multimodal_HMI.Views.PaymentResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>

  <Grid>

    <!-- ===== Pago fallido / rechazado / expirado (tu tarjeta original) ===== -->
    <Border Style="{StaticResource PanelCard}" Width="340"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Visibility="{Binding IsFailure, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                   FontSize="72" HorizontalAlignment="Center"
                   Foreground="{StaticResource DangerBrush}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Subtitle}" Margin="0,8,0,0"/>
        <Button Content="{Binding ButtonText}" Style="{StaticResource PrimaryButton}"
                Margin="0,24,0,0" HorizontalAlignment="Center"
                Command="{Binding ContinueCommand}"/>
      </StackPanel>
    </Border>

    <!-- ===== Pago aprobado (fase Paid) ===== -->
    <StackPanel Margin="40,64,40,0" VerticalAlignment="Top"
                Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
      <Image Source="/Assets/ice_top_left.png" Width="160"
             HorizontalAlignment="Right" Margin="0,-64,-40,-90"
             RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <ScaleTransform ScaleX="-1"/>
        </Image.RenderTransform>
      </Image>

      <Border Style="{StaticResource PanelCard}" Padding="28,16">
        <StackPanel>
          <TextBlock Text="{Binding DrinkName}" Style="{StaticResource Title}"
                     FontSize="34" TextAlignment="Left"/>
          <TextBlock Text="{Binding PriceText}" Style="{StaticResource DrinkPrice}"
                     TextAlignment="Left"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource PanelCard}" Margin="0,24,0,0" Padding="28,16,28,48">
        <StackPanel>
          <TextBlock Text="Pago Realizado&#10;con éxito" Style="{StaticResource Title}"
                     FontSize="34" TextAlignment="Left"/>
          <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="200"
                     Foreground="{StaticResource HintBrush}"
                     HorizontalAlignment="Center" Margin="0,40,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ===== Overlay: preparando bebida (fase Preparing) ===== -->
    <Border Background="{StaticResource AccentBrush}" CornerRadius="24"
            Margin="24,0" Padding="24,48" VerticalAlignment="Center"
            Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="34" FontWeight="Bold" Foreground="White">
          <Run Text="Espera un momento mientras preparo tu "/><Run Text="bebida" Foreground="{StaticResource HintBrush}"/>
        </TextBlock>

        <!-- Spinner: 8 barras, el grupo gira a pasos de 45° -->
        <Grid Width="120" Height="120" Margin="0,40,0,0" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <RotateTransform x:Name="SpinnerRotate"/>
          </Grid.RenderTransform>
          <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpinnerRotate"
                                                 Storyboard.TargetProperty="Angle">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="45"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="90"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="135"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="180"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="225"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="270"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.7" Value="315"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="360"/>
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Grid.Triggers>

          <Grid.Resources>
            <Style TargetType="Border">
              <Setter Property="Width" Value="14"/>
              <Setter Property="Height" Value="34"/>
              <Setter Property="CornerRadius" Value="7"/>
              <Setter Property="Background" Value="White"/>
              <Setter Property="VerticalAlignment" Value="Top"/>
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="RenderTransformOrigin" Value="0.5,1.765"/>
            </Style>
          </Grid.Resources>
          <Border Opacity="1.00">
            <Border.RenderTransform>
              <RotateTransform Angle="0"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.85">
            <Border.RenderTransform>
              <RotateTransform Angle="45"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.70">
            <Border.RenderTransform>
              <RotateTransform Angle="90"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.55">
            <Border.RenderTransform>
              <RotateTransform Angle="135"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.40">
            <Border.RenderTransform>
              <RotateTransform Angle="180"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.30">
            <Border.RenderTransform>
              <RotateTransform Angle="225"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.20">
            <Border.RenderTransform>
              <RotateTransform Angle="270"/>
            </Border.RenderTransform>
          </Border>
          <Border Opacity="0.12">
            <Border.RenderTransform>
              <RotateTransform Angle="315"/>
            </Border.RenderTransform>
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ===== Pantalla final: orden lista (fase Ready) ===== -->
    <Grid Background="Black"
          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
      <Image Source="/Assets/ice_top_left.png" Width="220"
             HorizontalAlignment="Left" VerticalAlignment="Top"/>
      <Image Source="/Assets/ice_top_left.png" Width="220"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <ScaleTransform ScaleX="-1"/>
        </Image.RenderTransform>
      </Image>
      <Image Source="/Assets/ice_bottom_left.png" Width="220"
             HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
      <Image Source="/Assets/ice_bottom_right.png" Width="220"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

      <Border Style="{StaticResource PanelCard}" Margin="64,0"
              VerticalAlignment="Center" Padding="24,40">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" FontSize="34"
                     Text="Tu orden&#10;está lista…"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="40" Margin="0,32,0,0"
                     Text="DISFRUTA!"/>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
