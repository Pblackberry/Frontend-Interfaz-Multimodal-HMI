<UserControl x:Class="Frontend_interfaz_Multimodal_HMI.Views.PaymentResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Style="{StaticResource PanelCard}" Width="340"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                   FontSize="72" HorizontalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Subtitle}" Margin="0,8,0,0"/>

        <Button Content="{Binding ButtonText}" Style="{StaticResource PrimaryButton}"
                Margin="0,24,0,0" HorizontalAlignment="Center"
                Command="{Binding ContinueCommand}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
