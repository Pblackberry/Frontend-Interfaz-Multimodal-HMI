<UserControl x:Class="Frontend_interfaz_Multimodal_HMI.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Hielo abajo a la izquierda (reutiliza el PNG derecho volteado;
         reemplázalo por el export de Figma cuando lo tengas) -->
    <Image Source="/Assets/ice_bottom_right.png" Width="170"
           HorizontalAlignment="Left" VerticalAlignment="Bottom"
           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="-1"/>
      </Image.RenderTransform>
    </Image>

    <Grid Margin="24,24,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Cabecera -->
      <Border Style="{StaticResource PanelCard}" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Selecciona tu bebida del menú" Style="{StaticResource Subtitle}"/>
          <TextBlock Text="“Rony, quiero un cuba libre”" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Cuadrícula de bebidas (2 columnas, con scroll táctil si hay más de 4) -->
      <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                    VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource DrinkCardButton}"
                      Command="{Binding DataContext.SelectDrinkCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}">
                <StackPanel>
                  <!-- Placeholder + imagen encima: sin URL solo se ve el cuadro gris;
                       con URL la imagen lo cubre -->
                  <Grid Width="110" Height="110" HorizontalAlignment="Center">
                    <Border Background="#EDEDED" CornerRadius="8"/>
                    <Image Source="{Binding ImageUrl}" Stretch="Uniform"/>
                  </Grid>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Subtitle}" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding PriceText}" Style="{StaticResource DrinkPrice}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Mensaje cuando no hay bebidas -->
      <TextBlock Grid.Row="1" Text="No hay bebidas disponibles por ahora."
                 HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>
