<UserControl x:Class="Frontend_interfaz_Multimodal_HMI.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Image Source="/Assets/ice_bottom_right.png" Width="170"
           HorizontalAlignment="Left" VerticalAlignment="Bottom"
           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="-1"/>
      </Image.RenderTransform>
    </Image>

    <Grid Margin="24,24,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Style="{StaticResource PanelCard}" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Selecciona tu bebida del menú" Style="{StaticResource Subtitle}"/>
          <TextBlock Text="“Rony, quiero un cuba libre”" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                    VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource DrinkCardButton}"
              Width="200" Height="230"
              Command="{Binding DataContext.SelectDrinkCommand,
                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Grid Width="110" Height="110" HorizontalAlignment="Center">
                    <Border CornerRadius="8">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#EDEDED"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                    <Image Source="{Binding Image}" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>

                  <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Subtitle}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                  <TextBlock Grid.Row="2" Text="{Binding PriceText}" Style="{StaticResource DrinkPrice}"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="1" Text="No hay bebidas disponibles por ahora."
                 HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>
