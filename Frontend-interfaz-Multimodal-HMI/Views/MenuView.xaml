<UserControl x:Class="Frontend_interfaz_Multimodal_HMI.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>
  <Grid>
    <Image Source="/Assets/ice_bottom_right.png" Width="170"
           HorizontalAlignment="Left" VerticalAlignment="Bottom"
           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="-1"/>
      </Image.RenderTransform>
    </Image>

    <Grid Margin="24,24,24,0">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Style="{StaticResource PanelCard}" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Selecciona tu bebida del menú" Style="{StaticResource Subtitle}"/>
          <TextBlock Text="“Rony, quiero un cuba libre”" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                    VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="200" Height="230" Margin="8">

                <Button Style="{StaticResource DrinkCardButton}" Margin="0"
            Command="{Binding DataContext.SelectDrinkCommand,
                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="110"/>
                      <RowDefinition Height="52"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Width="110" Height="110" HorizontalAlignment="Center">
                      <Border CornerRadius="8">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#EDEDED"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasImage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                      <Image Source="{Binding Image}" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Subtitle}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Text="{Binding PriceText}" Style="{StaticResource DrinkPrice}"/>
                  </Grid>
                </Button>

                <Button Style="{StaticResource InfoButton}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
            Visibility="{Binding HasIngredients, Converter={StaticResource BoolToVis}}"
            Command="{Binding DataContext.ShowIngredientsCommand,
                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="18"/>
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="1" Text="No hay bebidas disponibles por ahora."
                 HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <Grid Visibility="{Binding IsInfoOpen, Converter={StaticResource BoolToVis}}">

      <Border Background="#B3000000">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding CloseIngredientsCommand}"/>
        </Border.InputBindings>
      </Border>

      <Border DataContext="{Binding InfoDrink}"
    Background="White" CornerRadius="16" Padding="28,24"
    MinWidth="300" MaxWidth="400" Margin="32"
    HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Ingredientes" FontSize="22" FontWeight="Bold"
           Foreground="{StaticResource AccentBrush}" Margin="0,6,0,10"/>

          <ItemsControl ItemsSource="{Binding Ingredients}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <TextBlock Text="•" FontSize="22" Margin="0,0,10,0"/>
                  <TextBlock Text="{Binding Display}" FontSize="22" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
