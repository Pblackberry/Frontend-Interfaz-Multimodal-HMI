<Application x:Class="Frontend_interfaz_Multimodal_HMI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Frontend_interfaz_Multimodal_HMI"
             xmlns:vm="clr-namespace:Frontend_interfaz_Multimodal_HMI.ViewModels"
             xmlns:views="clr-namespace:Frontend_interfaz_Multimodal_HMI.Views">
    <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ViewModel -> Vista: base de la navegación -->
      <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
        <views:WelcomeView/>
      </DataTemplate>
      <!--<DataTemplate DataType="{x:Type vm:MenuViewModel}">
        <views:MenuView/>
      </DataTemplate>-->
    </ResourceDictionary>
  </Application.Resources>
</Application>
